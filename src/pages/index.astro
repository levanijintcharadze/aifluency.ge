---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PAGES, SITE } from '../lib/site';

const page = PAGES.index;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: page.description,
  inLanguage: 'ka',
};

const topics: { title: string; text: string; href?: string }[] = [
  {
    title: 'საფუძვლები',
    text: 'რა არის ხელოვნური ინტელექტი, როგორ მუშაობს ჩატბოტი და რატომ ცდება ის ზოგჯერ.',
  },
  {
    title: 'უსაფრთხოება',
    text: 'პირადი მონაცემების დაცვა, დიპფეიკების ამოცნობა და ხმის კლონირებით თაღლითობა.',
  },
  {
    title: 'პასუხისმგებლიანი გამოყენება',
    text: 'ფაქტების გადამოწმება, კეთილსინდისიერება, მიკერძოება და საავტორო უფლებები.',
  },
  {
    title: 'პრაქტიკა',
    text: 'მზა ქართული პრომპტები სწავლისთვის, მუშაობისთვის და ყოველდღიური საქმეებისთვის.',
  },
  {
    title: '4D ჩარჩო',
    text: 'AI-თან მუშაობის ოთხი უნარი: დელეგირება, აღწერა, განსჯა და პასუხისმგებლობა.',
    href: '/4d-framework/',
  },
];
---

<BaseLayout title={page.title} description={page.description} ogKey="index" jsonLd={jsonLd}>
  <section class="prose">
    <h1>ხელოვნური ინტელექტი გონივრულად, უსაფრთხოდ და პასუხისმგებლობით</h1>
    <p>
      AI Fluency საგანმანათლებლო საიტია ყველასთვის. აქ მარტივად და მაგალითებით
      ავხსნით, როგორ მუშაობს ხელოვნური ინტელექტი, სად შეიძლება დაგეხმაროს და სად უნდა იყო
      ფრთხილად.
    </p>
  </section>

  <section aria-labelledby="topics-title">
    <h2 id="topics-title">რას ვისწავლით</h2>
    <ul class="cards">
      {
        topics.map((t) => (
          <li class="card">
            <h3>{t.href ? <a href={t.href}>{t.title}</a> : t.title}</h3>
            <p>{t.text}</p>
          </li>
        ))
      }
    </ul>
    <p><a href="/articles/">სტატიების ნახვა →</a></p>
  </section>
</BaseLayout>
