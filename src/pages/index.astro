---
import BaseLayout from '../layouts/BaseLayout.astro';

const audiences = [
  {
    title: 'მოსწავლეებისთვის',
    text: 'როგორ დაგეხმაროს ხელოვნური ინტელექტი სწავლაში ისე, რომ შენი პირადი ინფორმაცია დაცული იყოს და დავალება მართლა შენი იყოს.',
  },
  {
    title: 'სტუდენტებისთვის',
    text: 'კვლევა, ფაქტების გადამოწმება, აკადემიური კეთილსინდისიერება და ის, თუ როგორ მიუთითო AI-ის გამოყენება ნაშრომში.',
  },
  {
    title: 'მასწავლებლებისთვის',
    text: 'გაკვეთილის გეგმები, საკლასო აქტივობები, შეფასების იდეები და რჩევები სკოლის AI-პოლიტიკისთვის.',
  },
];

const pillars = [
  'საფუძვლები: რა არის ხელოვნური ინტელექტი და რატომ ცდება ის ზოგჯერ',
  'უსაფრთხოება: პირადი მონაცემები, დიპფეიკები და თაღლითობა',
  'პასუხისმგებლიანი გამოყენება: გადამოწმება, კეთილსინდისიერება, მიკერძოება',
  'პრაქტიკა: მზა ქართული პრომპტები სწავლისა და სწავლებისთვის',
  '4D ჩარჩო (Delegation, Description, Discernment, Diligence): AI-თან მუშაობის ოთხი უნარი',
];
---

<BaseLayout title="AI Fluency">
  <section class="prose">
    <h1>ხელოვნური ინტელექტი — გონივრულად, უსაფრთხოდ, პასუხისმგებლობით</h1>
    <p>
      AI Fluency არაკომერციული საგანმანათლებლო საიტია. აქ მარტივად და მაგალითებით ავხსნით, როგორ
      მუშაობს ხელოვნური ინტელექტი, სად შეიძლება დაგეხმაროს და სად უნდა იყო ფრთხილად.
    </p>
  </section>

  <section aria-labelledby="audiences-title">
    <h2 id="audiences-title">ვისთვისაა ეს საიტი</h2>
    <ul class="cards">
      {
        audiences.map((a) => (
          <li class="card">
            <h3>{a.title}</h3>
            <p>{a.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="prose" aria-labelledby="pillars-title">
    <h2 id="pillars-title">რას ვისწავლით</h2>
    <ul>
      {pillars.map((p) => <li>{p}</li>)}
    </ul>
    <p><a href="/articles/">სტატიების ნახვა →</a></p>
  </section>
</BaseLayout>
