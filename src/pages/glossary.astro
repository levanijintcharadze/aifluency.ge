---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Toc from '../components/Toc.astro';

import { PAGES, SITE } from '../lib/site';

const page = PAGES.glossary;
const terms = (await getCollection('glossary')).sort((a, b) =>
  a.data.term.localeCompare(b.data.term, 'ka'),
);

// ტერმინები ანბანის მიხედვით, თითო ასოზე ერთი ჯგუფი
const letters = [...new Set(terms.map((entry) => entry.data.term.charAt(0)))];
const groups = letters.map((letter, i) => ({
  letter,
  slug: `letter-${i + 1}`,
  entries: terms.filter((entry) => entry.data.term.charAt(0) === letter),
}));
const toc = groups.map((g) => ({ depth: 2, slug: g.slug, text: g.letter }));

const pageUrl = new URL('/glossary/', Astro.site ?? SITE.url).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  '@id': pageUrl,
  name: page.title,
  description: page.description,
  url: pageUrl,
  inLanguage: 'ka',
  hasDefinedTerm: terms.map((entry) => ({
    '@type': 'DefinedTerm',
    '@id': `${pageUrl}#${entry.id}`,
    name: entry.data.term,
    alternateName: entry.data.en,
    description: entry.data.definition,
    url: `${pageUrl}#${entry.id}`,
    inDefinedTermSet: pageUrl,
  })),
};
---

<BaseLayout title={page.title} description={page.description} ogKey="glossary" jsonLd={jsonLd} toc={toc}>
  <div class="prose">
    <h1>ტერმინთა ლექსიკონი</h1>
    <p class="lead">
      ხელოვნური ინტელექტის ძირითადი ცნებები მარტივი ახსნით. ყოველ ტერმინს ფრჩხილებში ინგლისური
      შესატყვისიც ახლავს.
    </p>

    <Toc items={toc} variant="inline" />

    <nav class="letter-index" aria-label="ანბანი">
      {groups.map((g) => <a href={`#${g.slug}`}>{g.letter}</a>)}
    </nav>

    {
      groups.map((group) => (
        <section class="glossary-group" aria-labelledby={group.slug}>
          <h2 id={group.slug} class="glossary-letter">{group.letter}</h2>
          <dl class="glossary">
            {group.entries.map((entry) => (
              <div class="glossary-entry">
                <dt id={entry.id}>
                  {entry.data.term} <span lang="en">{entry.data.en}</span>
                </dt>
                <dd>
                  <p>{entry.data.definition}</p>
                  {entry.data.note && <p class="glossary-note">{entry.data.note}</p>}
                </dd>
              </div>
            ))}
          </dl>
        </section>
      ))
    }
  </div>
</BaseLayout>
