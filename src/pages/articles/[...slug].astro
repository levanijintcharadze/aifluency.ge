---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, pillarLabels } from '../../lib/labels';
import { SITE, articleOgKey } from '../../lib/site';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  );
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const { title, description, pillar, updated, sources, draft } = article.data;

const site = Astro.site ?? new URL(SITE.url);
const ogKey = articleOgKey(article.id);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  inLanguage: 'ka',
  dateModified: updated.toISOString(),
  mainEntityOfPage: new URL(Astro.url.pathname, site).href,
  image: new URL(`/og/${ogKey}.png`, site).href,
  articleSection: pillarLabels[pillar],
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
    logo: { '@type': 'ImageObject', url: new URL('/apple-touch-icon.png', site).href },
  },
  citation: sources.map((source) => source.url),
};
---

<BaseLayout
  title={title}
  description={description}
  ogKey={ogKey}
  type="article"
  modified={updated}
  noindex={draft}
  jsonLd={jsonLd}
>
  <article class="prose">
    <header>
      {draft && <p class="meta"><strong>მონახაზი: ჯერ არ გამოქვეყნებულა</strong></p>}
      <h1>{title}</h1>
      <p class="meta">
        <span class="tag">{pillarLabels[pillar]}</span>
      </p>
      <p class="meta">
        ბოლო განახლება: <time datetime={updated.toISOString()}>{formatDate(updated)}</time>
      </p>
    </header>

    <Content />

    {
      sources.length > 0 && (
        <section aria-labelledby="sources-title">
          <h2 id="sources-title">წყაროები</h2>
          <ol>
            {sources.map((source) => (
              <li>
                <a href={source.url} rel="noopener">
                  {source.title}
                </a>
              </li>
            ))}
          </ol>
        </section>
      )
    }
  </article>
</BaseLayout>
