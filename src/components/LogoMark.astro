---
// AI Fluency-ის ნიშანი: ქართული „ა“ ცისფერ კვადრატში, ქარვისფერი წერტილით.
// ასოს კონტური აღებულია DejaVu Sans Bold-იდან, ამიტომ ნებისმიერ მოწყობილობაზე ერთნაირად ჩანს.
interface Props {
  size?: number;
  label?: string;
}

const { size = 36, label } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 64 64"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <rect width="64" height="64" rx="16" fill="var(--brand-primary, #1F5FBF)"></rect>
  <path transform="matrix(0.02709 0 0 -0.02709 14.639 49.214)" fill="#FFFFFF" d="M1034 444Q1034 -29 566 -29Q100 -29 100 456L133 674H447L413 451Q415 195 569 195Q717 195 717 444Q717 628 534.5 798.0Q352 968 352 1226H676Q677 1038 855.5 868.5Q1034 699 1034 444Z"></path>
  <circle cx="50" cy="15" r="5" fill="var(--brand-amber, #F2A93B)"></circle>
</svg>
