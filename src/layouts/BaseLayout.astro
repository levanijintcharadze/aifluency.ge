---
import '../styles/global.css';
import LogoMark from '../components/LogoMark.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'ხელოვნური ინტელექტის გონივრული, უსაფრთხო და პასუხისმგებლიანი გამოყენება: მარტივად, მაგალითებით, ყველასთვის.',
} = Astro.props;

const siteName = 'AI Fluency';
const pageTitle = title === siteName ? siteName : `${title} — ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site);

const nav = [
  { href: '/', label: 'მთავარი' },
  { href: '/articles/', label: 'სტატიები' },
  { href: '/glossary/', label: 'ლექსიკონი' },
  { href: '/about/', label: 'პროექტის შესახებ' },
];

const current = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---

<!doctype html>
<html lang="ka">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1F5FBF" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ka_GE" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AI Fluency — ხელოვნური ინტელექტი გონივრულად, უსაფრთხოდ, პასუხისმგებლობით" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link" href="#main">მთავარ შიგთავსზე გადასვლა</a>

    <header class="site-header">
      <div class="container header-inner">
        <a class="logo" href="/" aria-label="AI Fluency — მთავარი გვერდი">
          <LogoMark size={36} />
          <span>AI Fluency</span>
        </a>
        <nav aria-label="მთავარი ნავიგაცია">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>
          AI Fluency არაკომერციული პროექტია: რეკლამის, სპონსორობისა და ფასიანი შიგთავსის გარეშე.
        </p>
        <p>
          შიგთავსი ვრცელდება <a href="https://creativecommons.org/licenses/by-sa/4.0/" rel="license">CC BY-SA 4.0</a> ლიცენზიით, კოდი — MIT ლიცენზიით.
        </p>
      </div>
    </footer>
  </body>
</html>
