---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { GOOGLE_TAG_ID, SITE } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  /** გაზიარების სურათის სახელი: /og/<ogKey>.png. თუ არ არის, საერთო სურათი გამოიყენება. */
  ogKey?: string;
  type?: 'website' | 'article';
  /** სტატიის ბოლო განახლება */
  modified?: Date;
  /** ძიების სისტემებმა გვერდი არ უნდა დააინდექსონ (404, მონახაზები) */
  noindex?: boolean;
  /** Schema.org სტრუქტურირებული მონაცემები */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = SITE.description,
  ogKey,
  type = 'website',
  modified,
  noindex = false,
  jsonLd,
} = Astro.props;

const site = Astro.site ?? new URL(SITE.url);
const pageTitle = title === SITE.name ? SITE.name : `${title} | ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL(ogKey ? `/og/${ogKey}.png` : '/og.png', site);
const structuredData = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : undefined;
---

<!doctype html>
<html lang="ka">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // თემა გვერდის დახატვამდე დგინდება, რომ ეკრანი არ „აციმციმდეს“.
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        var theme = null;
        try {
          theme = localStorage.getItem('theme');
        } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        root.dataset.theme = theme;
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="preload" href="/fonts/FiraGO-Regular.woff" as="font" type="font/woff" crossorigin />
    <meta name="theme-color" content="#1F5FBF" />

    <meta property="og:type" content={type} />
    <meta property="og:locale" content="ka_GE" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {structuredData && <script is:inline type="application/ld+json" set:html={structuredData} />}

    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link" href="#main">მთავარ შიგთავსზე გადასვლა</a>

    <SiteHeader />

    <main id="main" class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <nav class="footer-links" aria-label="დამატებითი ბმულები">
          <a href="/privacy/">კონფიდენციალურობა</a>
          {GOOGLE_TAG_ID && (
            <button type="button" class="link-button" data-consent-open>
              ქუქი-ფაილების პარამეტრები
            </button>
          )}
        </nav>
        <p>
          შიგთავსი ვრცელდება <a href="https://creativecommons.org/licenses/by-sa/4.0/" rel="license">CC BY-SA 4.0</a> ლიცენზიით, კოდი კი MIT ლიცენზიით.
        </p>
      </div>
    </footer>

    {GOOGLE_TAG_ID && <ConsentBanner tagId={GOOGLE_TAG_ID} />}
  </body>
</html>
